@import "tailwindcss";

@theme {
  --color-primary: #1A3626;
  --color-secondary: #6A994E;
  --color-background: #FDFBF7;
  --color-accent: #D4AF37;
  --color-surface: #F4F1EA;
  --color-primary-dark: #0f2117;

  --font-serif: var(--font-playfair), serif;
  --font-sans: var(--font-inter), sans-serif;

  --shadow-elegant: 0 10px 40px -10px rgba(26, 54, 38, 0.1);
  --shadow-card: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
}

body {
  @apply bg-white text-zinc-800 font-sans antialiased;
}

h1, h2, h3, h4, h5, h6 {
  @apply font-bold;
}